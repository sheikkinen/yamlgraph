{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-probe.sh",
        "timeout": 5
      },
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-briefing.sh",
        "timeout": 8
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-probe.sh",
        "timeout": 5
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-probe.sh",
        "timeout": 5
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-probe.sh",
        "timeout": 5
      }
    ],
    "PostCompact": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-probe.sh",
        "timeout": 5
      }
    ],
    "PostToolUseFailure": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-probe.sh",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-probe.sh",
        "timeout": 5
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-probe.sh",
        "timeout": 5
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-probe.sh",
        "timeout": 5
      }
    ],
    "PermissionRequest": [],
    "Notification": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-probe.sh",
        "timeout": 5
      }
    ],
    "TeammateIdle": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-probe.sh",
        "timeout": 5
      }
    ],
    "TaskCreated": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-probe.sh",
        "timeout": 5
      }
    ],
    "TaskCompleted": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-probe.sh",
        "timeout": 5
      }
    ]
  }
}
