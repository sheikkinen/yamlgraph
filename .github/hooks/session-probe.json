{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-probe.sh",
        "timeout": 5
      },
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-briefing.sh",
        "timeout": 8
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-probe.sh",
        "timeout": 5
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-probe.sh",
        "timeout": 5
      }
    ]
  }
}
