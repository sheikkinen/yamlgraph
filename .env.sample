# LLM Provider Configuration
# At least one API key is required depending on which provider you use

# Anthropic (default provider)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Mistral (optional - only needed if using Mistral)
MISTRAL_API_KEY=your-mistral-api-key-here

# OpenAI (optional - only needed if using OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Replicate (optional - only needed for storyboard image generation)
REPLICATE_API_TOKEN=r8_your-replicate-api-token-here

# XAI (optional - only needed if using XAI)
XAI_API_KEY=xai-your-xai-api-key-here

# Inception (optional - only needed if using Inception)
INCEPTION_API_KEY=sk_your-inception-api-key-here

# DeepSeek (optional - only needed if using DeepSeek)
DEEPSEEK_API_KEY=sk_your-deepseek-api-key-here

# LM Studio (optional - local LLM via LM Studio)
# No API key needed - runs locally
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen2.5-coder-7b-instruct

# Google Vertex AI (optional - only needed if using provider: vertex)
# Uses Application Default Credentials (ADC) - no API key needed
# Run: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# VERTEX_MODEL=gemini-2.0-flash

# Azure AI (optional - only needed if using provider: azure)
# Requires: pip install yamlgraph[azure]
AZURE_AI_ENDPOINT=https://my-resource.services.ai.azure.com/openai/v1
AZURE_AI_API_KEY=your-azure-ai-api-key-here
# AZURE_MODEL=gpt-4o

# RunPod (optional - only needed if using provider: runpod)
# RUNPOD_ENDPOINT is the full OpenAI-compatible base URL:
#   Public API:      https://api.runpod.ai/v2/<model-slug>/openai/v1
#   Serverless vLLM: https://api.runpod.ai/v2/<endpoint-id>/openai/v1
# Serverless cold starts can take tens of seconds - use per-node
# timeout / on_error: retry in graph YAML.
RUNPOD_API_KEY=rpa_your-runpod-api-key-here
RUNPOD_ENDPOINT=https://api.runpod.ai/v2/your-endpoint/openai/v1
RUNPOD_MODEL=your-served-model-name

# Default Provider Selection (optional)
# Options: anthropic, azure, deepseek, google, inception, lmstudio, mistral, openai, replicate, runpod, vertex, xai
# Default: anthropic
# PROVIDER=anthropic

# Model Configuration (optional - defaults shown)
# ANTHROPIC_MODEL=claude-haiku-4-5
# MISTRAL_MODEL=mistral-large-latest
# OPENAI_MODEL=gpt-4o
# DEEPSEEK_MODEL=deepseek-reasoner

# LangSmith/LangChain Tracing (optional - for observability)
LANGCHAIN_TRACING=true
LANGCHAIN_API_KEY=lsv2_your-langsmith-api-key-here
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=yamlgraph-app

# Daily Digest Example (optional - only needed for examples/daily_digest)
RESEND_API_KEY=re_your-resend-api-key-here
RECIPIENT_EMAIL=you@example.com
DIGEST_API_TOKEN=your-secret-token-for-fly-io
DIGEST_FROM_EMAIL=YAMLGraph <yamlgraph-no-reply@resend.dev>

# LAN recon (optional - only needed if using .github/skills/lan-recon)
# Bare Windows local-account username (e.g. `copilot`). Recon qualifies as
# <COMPUTERNAME>\<user> before the WinRM handshake. Already-qualified or
# domain-shaped values are refused in v1. See FR-945 for the read-only
# non-admin contract and reference/development-operations.md for setup.
# LAN_RECON_USER=
# LAN_RECON_PASS=

# LAN Copilot delegation (optional - only needed if using
# .github/skills/lan-delegate; see FR-948). Reuses LAN_RECON_USER /
# LAN_RECON_PASS above for the WinRM handshake. GH_TOKEN is the GitHub
# personal-access token minted for the remote copilot account; it is
# forwarded to the remote wrapper as a script parameter, exported to the
# `copilot` CLI subshell as $env:GH_TOKEN, and redacted from every
# captured stdout/stderr byte and every artifact before the summary
# leaves the remote. Never quote this value; leave commented out if the
# skill is not in use.
# GH_TOKEN=
