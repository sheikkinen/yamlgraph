{"ts": "2026-05-25T18:17:47.609Z", "source": "system", "kind": "utterance", "text": "Hei, olen Hieronta Maatti. Millä nimellä kutsumme teidät hierontaan?", "call_sid": "CAf6465a05873ae3ab1ef379ab1d59f445", "stream_sid": "MZ7492b79ac44e019c4b41f697764bd2a7", "speaking": true, "listening": false}
{"ts": "2026-05-25T18:18:01.793Z", "source": "user", "kind": "utterance", "text": "Nimeni on testihenkilö ja edustan organisaatiota testi OY.", "call_sid": "CAf6465a05873ae3ab1ef379ab1d59f445", "stream_sid": "MZ7492b79ac44e019c4b41f697764bd2a7", "speaking": false, "listening": false}
{"ts": "2026-05-25T18:18:03.066Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CAf6465a05873ae3ab1ef379ab1d59f445", "stream_sid": "MZ7492b79ac44e019c4b41f697764bd2a7", "speaking": true, "listening": false}
{"ts": "2026-05-25T18:18:05.973Z", "source": "system", "kind": "utterance", "text": "Mikä on teille mukava muisto näiltä tai aiemmilta ATK-päiviltä?", "call_sid": "CAf6465a05873ae3ab1ef379ab1d59f445", "stream_sid": "MZ7492b79ac44e019c4b41f697764bd2a7", "speaking": true, "listening": false}
{"ts": "2026-05-25T18:18:20.978Z", "source": "user", "kind": "utterance", "text": "Muistan kun ensimmäinen tietokone tuli toimistoon.", "call_sid": "CAf6465a05873ae3ab1ef379ab1d59f445", "stream_sid": "MZ7492b79ac44e019c4b41f697764bd2a7", "speaking": false, "listening": false}
{"ts": "2026-05-25T18:18:22.262Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CAf6465a05873ae3ab1ef379ab1d59f445", "stream_sid": "MZ7492b79ac44e019c4b41f697764bd2a7", "speaking": true, "listening": false}
{"ts": "2026-05-25T18:18:25.593Z", "source": "system", "kind": "utterance", "text": "Eli kutsumme teidät nimellä testihenkilö, organisaatiosta testi OY, ja muistonne ATK-päiviltä on: “Muistan kun ensimmäinen tietokone tuli toimistoon.” Onko tämä oikein?", "call_sid": "CAf6465a05873ae3ab1ef379ab1d59f445", "stream_sid": "MZ7492b79ac44e019c4b41f697764bd2a7", "speaking": true, "listening": false}
{"ts": "2026-05-25T18:18:53.532Z", "source": "system", "kind": "utterance", "text": "En valitettavasti kuule sinua.", "call_sid": "CAf6465a05873ae3ab1ef379ab1d59f445", "stream_sid": "MZ7492b79ac44e019c4b41f697764bd2a7", "speaking": true, "listening": false}
{"ts": "2026-05-25T18:19:37.916Z", "source": "user", "kind": "utterance", "text": "Kyllä yhteenveto on oikein.", "call_sid": "CAf6465a05873ae3ab1ef379ab1d59f445", "stream_sid": "MZ7492b79ac44e019c4b41f697764bd2a7", "speaking": false, "listening": false}
{"ts": "2026-05-25T18:19:39.208Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CAf6465a05873ae3ab1ef379ab1d59f445", "stream_sid": "MZ7492b79ac44e019c4b41f697764bd2a7", "speaking": true, "listening": false}
{"ts": "2026-05-25T18:19:41.844Z", "source": "system", "kind": "utterance", "text": "Kiitoksia. Kutsumme teidät mahdollisimman pian. Kuulemiin.", "call_sid": "CAf6465a05873ae3ab1ef379ab1d59f445", "stream_sid": "MZ7492b79ac44e019c4b41f697764bd2a7", "speaking": true, "listening": false}
