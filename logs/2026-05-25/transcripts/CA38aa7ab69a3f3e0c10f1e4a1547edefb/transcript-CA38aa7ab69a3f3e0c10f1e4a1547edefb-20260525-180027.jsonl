{"ts": "2026-05-25T18:00:54.206Z", "source": "system", "kind": "utterance", "text": "En valitettavasti kuule sinua.", "call_sid": "CA38aa7ab69a3f3e0c10f1e4a1547edefb", "stream_sid": "MZb36ad44a314a6637855cc334f754cd54", "speaking": true, "listening": false}
