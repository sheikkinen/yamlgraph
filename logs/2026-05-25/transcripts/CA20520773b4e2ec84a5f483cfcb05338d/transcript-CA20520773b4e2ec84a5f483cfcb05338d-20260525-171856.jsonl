{"ts": "2026-05-25T17:19:00.035Z", "source": "user", "kind": "utterance", "text": "Molemmat.", "call_sid": "CA20520773b4e2ec84a5f483cfcb05338d", "stream_sid": "MZ145d8f3c2091bdbdd35481f17451d1a8", "speaking": false, "listening": false}
{"ts": "2026-05-25T17:19:02.182Z", "source": "system", "kind": "utterance", "text": "Hei, olen Hieronta Maatti. Millä nimellä kutsumme teidät hierontaan?", "call_sid": "CA20520773b4e2ec84a5f483cfcb05338d", "stream_sid": "MZ145d8f3c2091bdbdd35481f17451d1a8", "speaking": true, "listening": false}
{"ts": "2026-05-25T17:19:03.153Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA20520773b4e2ec84a5f483cfcb05338d", "stream_sid": "MZ145d8f3c2091bdbdd35481f17451d1a8", "speaking": true, "listening": false}
{"ts": "2026-05-25T17:19:12.084Z", "source": "system", "kind": "utterance", "text": "Voisitteko kertoa vielä koko nimenne, organisaationne sekä jonkin mukavan muiston näiltä tai aiemmilta ATK-päiviltä?", "call_sid": "CA20520773b4e2ec84a5f483cfcb05338d", "stream_sid": "MZ145d8f3c2091bdbdd35481f17451d1a8", "speaking": true, "listening": false}
{"ts": "2026-05-25T17:19:27.669Z", "source": "user", "kind": "utterance", "text": "Riikka Satakunnan hyvinvointialue ja ruoka oli todella hyvää.", "call_sid": "CA20520773b4e2ec84a5f483cfcb05338d", "stream_sid": "MZ145d8f3c2091bdbdd35481f17451d1a8", "speaking": false, "listening": false}
{"ts": "2026-05-25T17:19:28.965Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA20520773b4e2ec84a5f483cfcb05338d", "stream_sid": "MZ145d8f3c2091bdbdd35481f17451d1a8", "speaking": true, "listening": false}
{"ts": "2026-05-25T17:19:35.494Z", "source": "system", "kind": "utterance", "text": "Eli kutsumme teidät nimellä Riikka, Satakunnan hyvinvointialueelta, ja muistonanne ATK-päiviltä on, että ruoka oli todella hyvää. Onko tämä oikein?", "call_sid": "CA20520773b4e2ec84a5f483cfcb05338d", "stream_sid": "MZ145d8f3c2091bdbdd35481f17451d1a8", "speaking": true, "listening": false}
{"ts": "2026-05-25T17:19:50.645Z", "source": "user", "kind": "utterance", "text": "On oikein.", "call_sid": "CA20520773b4e2ec84a5f483cfcb05338d", "stream_sid": "MZ145d8f3c2091bdbdd35481f17451d1a8", "speaking": false, "listening": false}
{"ts": "2026-05-25T17:19:51.559Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA20520773b4e2ec84a5f483cfcb05338d", "stream_sid": "MZ145d8f3c2091bdbdd35481f17451d1a8", "speaking": true, "listening": false}
{"ts": "2026-05-25T17:19:59.919Z", "source": "system", "kind": "utterance", "text": "Kiitoksia. Kutsumme teidät mahdollisimman pian. Kuulemiin.", "call_sid": "CA20520773b4e2ec84a5f483cfcb05338d", "stream_sid": "MZ145d8f3c2091bdbdd35481f17451d1a8", "speaking": true, "listening": false}
{"ts": "2026-05-25T17:20:03.870Z", "source": "user", "kind": "utterance", "text": "Okei okei joo.", "call_sid": "CA20520773b4e2ec84a5f483cfcb05338d", "stream_sid": "MZ145d8f3c2091bdbdd35481f17451d1a8", "speaking": false, "listening": false}
