{"ts": "2026-05-25T18:22:31.298Z", "source": "system", "kind": "utterance", "text": "Hei, olen Hieronta Maatti. Millä nimellä kutsumme teidät hierontaan?", "call_sid": "CA227f7dc6415c52fc978cf667e4150b5b", "stream_sid": "MZ8e1b1ddfd72abf5bfbd4af81e02d6894", "speaking": true, "listening": false}
{"ts": "2026-05-25T18:22:36.305Z", "source": "user", "kind": "utterance", "text": "Toimii.", "call_sid": "CA227f7dc6415c52fc978cf667e4150b5b", "stream_sid": "MZ8e1b1ddfd72abf5bfbd4af81e02d6894", "speaking": false, "listening": false}
{"ts": "2026-05-25T18:22:37.206Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA227f7dc6415c52fc978cf667e4150b5b", "stream_sid": "MZ8e1b1ddfd72abf5bfbd4af81e02d6894", "speaking": true, "listening": false}
{"ts": "2026-05-25T18:22:40.362Z", "source": "user", "kind": "utterance", "text": "Minulle.", "call_sid": "CA227f7dc6415c52fc978cf667e4150b5b", "stream_sid": "MZ8e1b1ddfd72abf5bfbd4af81e02d6894", "speaking": false, "listening": false}
{"ts": "2026-05-25T18:22:41.279Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA227f7dc6415c52fc978cf667e4150b5b", "stream_sid": "MZ8e1b1ddfd72abf5bfbd4af81e02d6894", "speaking": true, "listening": false}
{"ts": "2026-05-25T18:22:42.502Z", "source": "system", "kind": "utterance", "text": "Voisitteko kertoa vielä koko nimenne ja organisaationne sekä jonkin mukavan muiston näiltä tai aiemmilta ATK-päiviltä?", "call_sid": "CA227f7dc6415c52fc978cf667e4150b5b", "stream_sid": "MZ8e1b1ddfd72abf5bfbd4af81e02d6894", "speaking": true, "listening": false}
{"ts": "2026-05-25T18:22:58.585Z", "source": "user", "kind": "utterance", "text": "Ville Terveystalo mentiin uimaan biitsille.", "call_sid": "CA227f7dc6415c52fc978cf667e4150b5b", "stream_sid": "MZ8e1b1ddfd72abf5bfbd4af81e02d6894", "speaking": false, "listening": false}
{"ts": "2026-05-25T18:22:59.931Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA227f7dc6415c52fc978cf667e4150b5b", "stream_sid": "MZ8e1b1ddfd72abf5bfbd4af81e02d6894", "speaking": true, "listening": false}
{"ts": "2026-05-25T18:23:03.276Z", "source": "system", "kind": "utterance", "text": "Eli kutsumme teidät nimellä Ville, organisaatiosta Terveystalo, ja muistonne ATK-päiviltä on, että mentiin uimaan biitsille. Onko tämä oikein?", "call_sid": "CA227f7dc6415c52fc978cf667e4150b5b", "stream_sid": "MZ8e1b1ddfd72abf5bfbd4af81e02d6894", "speaking": true, "listening": false}
{"ts": "2026-05-25T18:23:16.458Z", "source": "user", "kind": "utterance", "text": "On.", "call_sid": "CA227f7dc6415c52fc978cf667e4150b5b", "stream_sid": "MZ8e1b1ddfd72abf5bfbd4af81e02d6894", "speaking": false, "listening": false}
{"ts": "2026-05-25T18:23:17.396Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA227f7dc6415c52fc978cf667e4150b5b", "stream_sid": "MZ8e1b1ddfd72abf5bfbd4af81e02d6894", "speaking": true, "listening": false}
