{"ts": "2026-05-25T17:37:09.236Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CAfa732710834ae20e95a4390d94cd764e", "stream_sid": "MZ4bab81b691a22fcf046f617333e69b91", "speaking": true, "listening": false}
{"ts": "2026-05-25T17:37:18.461Z", "source": "user", "kind": "utterance", "text": "Moro kutsu vaikka.", "call_sid": "CAfa732710834ae20e95a4390d94cd764e", "stream_sid": "MZ4bab81b691a22fcf046f617333e69b91", "speaking": false, "listening": false}
