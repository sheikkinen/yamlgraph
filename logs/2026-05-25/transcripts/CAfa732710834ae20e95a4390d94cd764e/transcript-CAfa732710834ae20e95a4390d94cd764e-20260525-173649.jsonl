{"ts": "2026-05-25T17:37:31.970Z", "source": "system", "kind": "utterance", "text": "Voisitteko kertoa, mikä on koko nimenne, jotta voimme kirjata vastaajan tiedot oikein?", "call_sid": "CAfa732710834ae20e95a4390d94cd764e", "stream_sid": "MZ4bab81b691a22fcf046f617333e69b91", "speaking": true, "listening": false}
