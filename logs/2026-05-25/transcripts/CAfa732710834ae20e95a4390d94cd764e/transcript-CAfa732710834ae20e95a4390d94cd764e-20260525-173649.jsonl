{"ts": "2026-05-25T17:38:30.102Z", "source": "user", "kind": "utterance", "text": "Kaukalo on.", "call_sid": "CAfa732710834ae20e95a4390d94cd764e", "stream_sid": "MZ4bab81b691a22fcf046f617333e69b91", "speaking": false, "listening": false}
