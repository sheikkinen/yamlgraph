{"ts": "2026-05-26T11:31:31.645Z", "source": "system", "kind": "utterance", "text": "Olet soittanut Tervolan terveysasemalle.\nKeräisin esitietoja takaisinsoittoa varten.\nMiten voin auttaa?\n", "call_sid": "CAd0b43ba1f571ea4563ee388550ff6581", "stream_sid": "MZcdd37db52fa7d5a9b573aea63c7f85f3", "speaking": true, "listening": false}
{"ts": "2026-05-26T11:31:44.441Z", "source": "user", "kind": "utterance", "text": "Puhewokki.", "call_sid": "CAd0b43ba1f571ea4563ee388550ff6581", "stream_sid": "MZcdd37db52fa7d5a9b573aea63c7f85f3", "speaking": false, "listening": false}
{"ts": "2026-05-26T11:31:45.420Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CAd0b43ba1f571ea4563ee388550ff6581", "stream_sid": "MZcdd37db52fa7d5a9b573aea63c7f85f3", "speaking": true, "listening": false}
{"ts": "2026-05-26T11:31:47.470Z", "source": "system", "kind": "utterance", "text": "Kertoisitko tarkemmin, mistä on kyse?", "call_sid": "CAd0b43ba1f571ea4563ee388550ff6581", "stream_sid": "MZcdd37db52fa7d5a9b573aea63c7f85f3", "speaking": true, "listening": false}
{"ts": "2026-05-26T11:32:02.576Z", "source": "system", "kind": "utterance", "text": "En valitettavasti kuule sinua.", "call_sid": "CAd0b43ba1f571ea4563ee388550ff6581", "stream_sid": "MZcdd37db52fa7d5a9b573aea63c7f85f3", "speaking": true, "listening": false}
{"ts": "2026-05-26T11:33:02.628Z", "source": "system", "kind": "utterance", "text": "Pahoittelut, Auto Matti on epäkunnossa. Kuulemiin.", "call_sid": "CAd0b43ba1f571ea4563ee388550ff6581", "stream_sid": "MZcdd37db52fa7d5a9b573aea63c7f85f3", "speaking": true, "listening": false}
