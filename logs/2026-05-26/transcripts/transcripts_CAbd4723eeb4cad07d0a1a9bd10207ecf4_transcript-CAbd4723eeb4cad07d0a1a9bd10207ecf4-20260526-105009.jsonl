{"ts": "2026-05-26T10:50:18.463Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CAbd4723eeb4cad07d0a1a9bd10207ecf4", "stream_sid": "MZ4f90c4aa97cb0b13ea198a0bfc8e9677", "speaking": true, "listening": false}
