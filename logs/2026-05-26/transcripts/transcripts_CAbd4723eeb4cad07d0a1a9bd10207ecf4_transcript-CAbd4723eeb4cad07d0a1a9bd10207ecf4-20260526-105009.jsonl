{"ts": "2026-05-26T10:50:10.360Z", "source": "system", "kind": "utterance", "text": "Hei, olen Hieronta Maatti. Millä nimellä kutsumme teidät hierontaan?", "call_sid": "CAbd4723eeb4cad07d0a1a9bd10207ecf4", "stream_sid": "MZ4f90c4aa97cb0b13ea198a0bfc8e9677", "speaking": true, "listening": false}
