{"ts": "2026-05-26T08:10:55.085Z", "source": "system", "kind": "utterance", "text": "Hei, olen Hieronta Maatti. Millä nimellä kutsumme teidät hierontaan?", "call_sid": "CA89d9769741c2879a4572558a9cea4f6c", "stream_sid": "MZ98443d5de84435975000a2f79c25ed5b", "speaking": true, "listening": false}
{"ts": "2026-05-26T08:11:03.281Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA89d9769741c2879a4572558a9cea4f6c", "stream_sid": "MZ98443d5de84435975000a2f79c25ed5b", "speaking": true, "listening": false}
{"ts": "2026-05-26T08:11:22.013Z", "source": "user", "kind": "utterance", "text": "Olisin siinä nyt se ei sano enää mitään.", "call_sid": "CA89d9769741c2879a4572558a9cea4f6c", "stream_sid": "MZ98443d5de84435975000a2f79c25ed5b", "speaking": false, "listening": false}
{"ts": "2026-05-26T08:11:29.455Z", "source": "user", "kind": "utterance", "text": "Se kysyi nimeä ja sitten se vaan. Sitten se vaan sanoi että kiitos kirjaimet teidän tietoja ja nyt se on hiljaa.", "call_sid": "CA89d9769741c2879a4572558a9cea4f6c", "stream_sid": "MZ98443d5de84435975000a2f79c25ed5b", "speaking": false, "listening": false}
{"ts": "2026-05-26T08:11:30.735Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA89d9769741c2879a4572558a9cea4f6c", "stream_sid": "MZ98443d5de84435975000a2f79c25ed5b", "speaking": true, "listening": false}
{"ts": "2026-05-26T08:11:34.739Z", "source": "system", "kind": "utterance", "text": "Mikä organisaatio tai yritys teitä edustaa?", "call_sid": "CA89d9769741c2879a4572558a9cea4f6c", "stream_sid": "MZ98443d5de84435975000a2f79c25ed5b", "speaking": true, "listening": false}
{"ts": "2026-05-26T08:11:36.861Z", "source": "user", "kind": "utterance", "text": "Ei kun nyt se sanoo vaan että kiitos.", "call_sid": "CA89d9769741c2879a4572558a9cea4f6c", "stream_sid": "MZ98443d5de84435975000a2f79c25ed5b", "speaking": false, "listening": false}
{"ts": "2026-05-26T08:11:38.134Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA89d9769741c2879a4572558a9cea4f6c", "stream_sid": "MZ98443d5de84435975000a2f79c25ed5b", "speaking": true, "listening": false}
{"ts": "2026-05-26T08:11:41.473Z", "source": "user", "kind": "utterance", "text": "Palvelukeskuksessa.", "call_sid": "CA89d9769741c2879a4572558a9cea4f6c", "stream_sid": "MZ98443d5de84435975000a2f79c25ed5b", "speaking": false, "listening": false}
