{"ts": "2026-05-26T11:35:52.601Z", "source": "system", "kind": "utterance", "text": "Hei, olen Hieronta Maatti. Millä nimellä kutsumme teidät hierontaan?", "call_sid": "CA30f10fccc3c3b049838941903c9d148c", "stream_sid": "MZa4fc6465a3fcc3c93618a73f16fba3b0", "speaking": true, "listening": false}
{"ts": "2026-05-26T11:35:56.837Z", "source": "user", "kind": "utterance", "text": "Siis jotain. Ei vaan tuota.", "call_sid": "CA30f10fccc3c3b049838941903c9d148c", "stream_sid": "MZa4fc6465a3fcc3c93618a73f16fba3b0", "speaking": false, "listening": false}
{"ts": "2026-05-26T11:35:58.122Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA30f10fccc3c3b049838941903c9d148c", "stream_sid": "MZa4fc6465a3fcc3c93618a73f16fba3b0", "speaking": true, "listening": false}
{"ts": "2026-05-26T11:36:02.012Z", "source": "system", "kind": "utterance", "text": "Voisitteko kertoa vielä koko nimenne, niin saamme tiedot täydennettyä?", "call_sid": "CA30f10fccc3c3b049838941903c9d148c", "stream_sid": "MZa4fc6465a3fcc3c93618a73f16fba3b0", "speaking": true, "listening": false}
