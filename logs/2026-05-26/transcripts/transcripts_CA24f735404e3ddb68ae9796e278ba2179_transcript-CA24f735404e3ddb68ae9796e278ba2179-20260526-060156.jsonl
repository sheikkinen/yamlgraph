{"ts": "2026-05-26T06:02:27.190Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA24f735404e3ddb68ae9796e278ba2179", "stream_sid": "MZ8080ef8461b1bf69cdbedd90569c27d3", "speaking": true, "listening": false}
