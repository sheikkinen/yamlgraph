{"ts": "2026-05-26T12:07:00.834Z", "source": "system", "kind": "utterance", "text": "Hei, olen Hieronta Maatti. Millä nimellä kutsumme teidät hierontaan?", "call_sid": "CAac5418a6f385adde5116143a784eef2b", "stream_sid": "MZ4c9f3da73bca03dc631ae02b0939488f", "speaking": true, "listening": false}
