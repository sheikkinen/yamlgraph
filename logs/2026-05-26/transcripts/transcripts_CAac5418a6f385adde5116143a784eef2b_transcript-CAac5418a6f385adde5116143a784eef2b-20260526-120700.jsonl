{"ts": "2026-05-26T12:07:10.604Z", "source": "user", "kind": "utterance", "text": "No tässä on kalle gerbe hei.", "call_sid": "CAac5418a6f385adde5116143a784eef2b", "stream_sid": "MZ4c9f3da73bca03dc631ae02b0939488f", "speaking": false, "listening": false}
