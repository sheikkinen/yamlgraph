{"ts": "2026-05-26T02:07:23.724Z", "source": "system", "kind": "utterance", "text": "Hei, olen Hieronta Maatti. Millä nimellä kutsumme teidät hierontaan?", "call_sid": "CA77faa427cc508e5c4be1f7707f932b4a", "stream_sid": "MZ35c3b3e8337ceedf97657a5ba00e274a", "speaking": true, "listening": false}
{"ts": "2026-05-26T02:07:37.703Z", "source": "user", "kind": "utterance", "text": "Nimeni on testihenkilö ja edustan organisaatiota testi OY.", "call_sid": "CA77faa427cc508e5c4be1f7707f932b4a", "stream_sid": "MZ35c3b3e8337ceedf97657a5ba00e274a", "speaking": false, "listening": false}
{"ts": "2026-05-26T02:07:39.022Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA77faa427cc508e5c4be1f7707f932b4a", "stream_sid": "MZ35c3b3e8337ceedf97657a5ba00e274a", "speaking": true, "listening": false}
{"ts": "2026-05-26T02:07:46.271Z", "source": "system", "kind": "utterance", "text": "Mikä on teille mukava muisto näiltä tai aiemmilta ATK-päiviltä?", "call_sid": "CA77faa427cc508e5c4be1f7707f932b4a", "stream_sid": "MZ35c3b3e8337ceedf97657a5ba00e274a", "speaking": true, "listening": false}
{"ts": "2026-05-26T02:07:52.463Z", "source": "user", "kind": "utterance", "text": "Muistan kun ensimmäinen tietokone tuli toimistoon.", "call_sid": "CA77faa427cc508e5c4be1f7707f932b4a", "stream_sid": "MZ35c3b3e8337ceedf97657a5ba00e274a", "speaking": false, "listening": false}
{"ts": "2026-05-26T02:07:53.755Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA77faa427cc508e5c4be1f7707f932b4a", "stream_sid": "MZ35c3b3e8337ceedf97657a5ba00e274a", "speaking": true, "listening": false}
{"ts": "2026-05-26T02:07:57.470Z", "source": "system", "kind": "utterance", "text": "Eli kutsumme teidät nimellä testihenkilö, organisaatiosta testi OY, ja muistonne ATK-päiviltä on “Muistan kun ensimmäinen tietokone tuli toimistoon.” Onko tämä oikein?", "call_sid": "CA77faa427cc508e5c4be1f7707f932b4a", "stream_sid": "MZ35c3b3e8337ceedf97657a5ba00e274a", "speaking": true, "listening": false}
{"ts": "2026-05-26T02:08:18.969Z", "source": "user", "kind": "utterance", "text": "Kyllä yhteenveto on oikein.", "call_sid": "CA77faa427cc508e5c4be1f7707f932b4a", "stream_sid": "MZ35c3b3e8337ceedf97657a5ba00e274a", "speaking": false, "listening": false}
{"ts": "2026-05-26T02:08:20.252Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA77faa427cc508e5c4be1f7707f932b4a", "stream_sid": "MZ35c3b3e8337ceedf97657a5ba00e274a", "speaking": true, "listening": false}
{"ts": "2026-05-26T02:08:23.051Z", "source": "system", "kind": "utterance", "text": "Kiitoksia. Kutsumme teidät mahdollisimman pian. Kuulemiin.", "call_sid": "CA77faa427cc508e5c4be1f7707f932b4a", "stream_sid": "MZ35c3b3e8337ceedf97657a5ba00e274a", "speaking": true, "listening": false}
