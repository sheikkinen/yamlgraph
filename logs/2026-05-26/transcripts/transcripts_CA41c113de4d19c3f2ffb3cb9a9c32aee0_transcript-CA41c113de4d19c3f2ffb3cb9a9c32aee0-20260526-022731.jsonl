{"ts": "2026-05-26T02:27:32.276Z", "source": "system", "kind": "utterance", "text": "Hei, olen Hieronta Maatti. Millä nimellä kutsumme teidät hierontaan?", "call_sid": "CA41c113de4d19c3f2ffb3cb9a9c32aee0", "stream_sid": "MZa26c9ac3aac2cd4ad61e73ea56b87d22", "speaking": true, "listening": false}
{"ts": "2026-05-26T02:27:46.296Z", "source": "user", "kind": "utterance", "text": "Nimeni on testihenkilö ja edustan organisaatiota testi OY.", "call_sid": "CA41c113de4d19c3f2ffb3cb9a9c32aee0", "stream_sid": "MZa26c9ac3aac2cd4ad61e73ea56b87d22", "speaking": false, "listening": false}
{"ts": "2026-05-26T02:27:47.573Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA41c113de4d19c3f2ffb3cb9a9c32aee0", "stream_sid": "MZa26c9ac3aac2cd4ad61e73ea56b87d22", "speaking": true, "listening": false}
{"ts": "2026-05-26T02:27:51.746Z", "source": "system", "kind": "utterance", "text": "Mikä on teille mukava muisto näiltä tai aiemmilta ATK-päiviltä?", "call_sid": "CA41c113de4d19c3f2ffb3cb9a9c32aee0", "stream_sid": "MZa26c9ac3aac2cd4ad61e73ea56b87d22", "speaking": true, "listening": false}
{"ts": "2026-05-26T02:28:00.679Z", "source": "user", "kind": "utterance", "text": "Muistan kun ensimmäinen tietokone tuli toimistoon.", "call_sid": "CA41c113de4d19c3f2ffb3cb9a9c32aee0", "stream_sid": "MZa26c9ac3aac2cd4ad61e73ea56b87d22", "speaking": false, "listening": false}
{"ts": "2026-05-26T02:28:01.967Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA41c113de4d19c3f2ffb3cb9a9c32aee0", "stream_sid": "MZa26c9ac3aac2cd4ad61e73ea56b87d22", "speaking": true, "listening": false}
{"ts": "2026-05-26T02:28:06.563Z", "source": "system", "kind": "utterance", "text": "Eli kutsuisimme teitä nimellä testihenkilö, organisaatiosta testi OY, ja muistonne ATK-päiviltä on, että muistatte kun ensimmäinen tietokone tuli toimistoon. Onko tämä oikein?", "call_sid": "CA41c113de4d19c3f2ffb3cb9a9c32aee0", "stream_sid": "MZa26c9ac3aac2cd4ad61e73ea56b87d22", "speaking": true, "listening": false}
{"ts": "2026-05-26T02:28:35.009Z", "source": "system", "kind": "utterance", "text": "En valitettavasti kuule sinua.", "call_sid": "CA41c113de4d19c3f2ffb3cb9a9c32aee0", "stream_sid": "MZa26c9ac3aac2cd4ad61e73ea56b87d22", "speaking": true, "listening": false}
{"ts": "2026-05-26T02:28:48.280Z", "source": "user", "kind": "utterance", "text": "Kyllä yhteenveto on oikein.", "call_sid": "CA41c113de4d19c3f2ffb3cb9a9c32aee0", "stream_sid": "MZa26c9ac3aac2cd4ad61e73ea56b87d22", "speaking": false, "listening": false}
{"ts": "2026-05-26T02:28:49.596Z", "source": "system", "kind": "utterance", "text": "Kiitos. Kirjaan tietoja.", "call_sid": "CA41c113de4d19c3f2ffb3cb9a9c32aee0", "stream_sid": "MZa26c9ac3aac2cd4ad61e73ea56b87d22", "speaking": true, "listening": false}
{"ts": "2026-05-26T02:28:51.848Z", "source": "system", "kind": "utterance", "text": "Kiitoksia. Kutsumme teidät mahdollisimman pian. Kuulemiin.", "call_sid": "CA41c113de4d19c3f2ffb3cb9a9c32aee0", "stream_sid": "MZa26c9ac3aac2cd4ad61e73ea56b87d22", "speaking": true, "listening": false}
