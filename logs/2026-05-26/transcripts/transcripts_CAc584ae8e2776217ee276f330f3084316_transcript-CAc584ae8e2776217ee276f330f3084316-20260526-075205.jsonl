{"ts": "2026-05-26T07:52:06.095Z", "source": "system", "kind": "utterance", "text": "Hei, olen Hieronta Maatti. Millä nimellä kutsumme teidät hierontaan?", "call_sid": "CAc584ae8e2776217ee276f330f3084316", "stream_sid": "MZ95b1590d2ca791cd271fd9e09b374207", "speaking": true, "listening": false}
