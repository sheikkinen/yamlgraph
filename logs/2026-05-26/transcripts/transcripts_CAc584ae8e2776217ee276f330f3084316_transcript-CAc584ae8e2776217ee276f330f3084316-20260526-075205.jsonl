{"ts": "2026-05-26T07:52:13.807Z", "source": "user", "kind": "utterance", "text": "Ei kastanu siellä koska.", "call_sid": "CAc584ae8e2776217ee276f330f3084316", "stream_sid": "MZ95b1590d2ca791cd271fd9e09b374207", "speaking": false, "listening": false}
