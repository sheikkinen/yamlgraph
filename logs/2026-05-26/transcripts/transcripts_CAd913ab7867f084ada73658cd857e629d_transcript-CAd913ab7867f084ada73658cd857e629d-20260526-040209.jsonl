{"ts": "2026-05-26T04:02:10.422Z", "source": "system", "kind": "utterance", "text": "Hei, olen Hieronta Maatti. Millä nimellä kutsumme teidät hierontaan?", "call_sid": "CAd913ab7867f084ada73658cd857e629d", "stream_sid": "MZ6ac814c82ee736bb482352686b9a0df6", "speaking": true, "listening": false}
