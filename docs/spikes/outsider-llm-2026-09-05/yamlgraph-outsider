#!/usr/bin/env bash
# yamlgraph-outsider — standalone entry point (llm-node spike).
#   yamlgraph-outsider <pr-number> [--repo owner/name] [--post] [--model m] [--provider p]
#   yamlgraph-outsider --input <file.md> [--model m] [--provider p]
# Needs: yamlgraph (pip), gh (signed in), a provider API key in the environment or ./.env.
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"; cd "$HERE" || exit 1
PR=""; REPO="${OUTSIDER_GH_REPO:-sheikkinen/yamlgraph}"; POST=false; INPUT=""; MODEL="claude-sonnet-4-5"; PROVIDER="anthropic"
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPO="$2"; shift 2 ;; --post) POST=true; shift ;; --input) INPUT="$2"; shift 2 ;;
    --model) MODEL="$2"; shift 2 ;; --provider) PROVIDER="$2"; shift 2 ;;
    -*) echo "unknown flag $1" >&2; exit 64 ;; *) PR="$1"; shift ;;
  esac
done
[ -n "$PR$INPUT" ] || { echo "usage: yamlgraph-outsider <pr> | --input <file>" >&2; exit 64; }
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"; LABEL="${PR:-$(basename "${INPUT%.md}")}"
REPORT="out/${LABEL}-${MODEL}-${STAMP}.md"; LOG="out/${LABEL}-${MODEL}-${STAMP}.log"; mkdir -p out
yamlgraph graph run graph.yaml --var "pr=$PR" --var "repo=$REPO" --var "input_path=$INPUT" --var "post=$POST" \
  --var "provider=$PROVIDER" --var "model=$MODEL" --var "report_path=$REPORT" --full > "$LOG" 2>&1
RC=$?
# Verify by artifact, never by exit code.
if [ -s "$REPORT" ] && head -1 "$REPORT" | grep -q '^\*\*Derived verdict:\*\* \(YES\|NO\)'; then
  echo "yamlgraph-outsider: $(head -1 "$REPORT" | cut -c1-30) → $REPORT (rc=$RC)"; exit 0
fi
echo "yamlgraph-outsider: NO REPORT (rc=$RC); see $LOG" >&2; grep -iE 'error|rejected' "$LOG" | tail -3 >&2; exit 1
