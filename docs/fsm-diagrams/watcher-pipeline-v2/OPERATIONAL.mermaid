stateDiagram-v2
    %% Detailed view of OPERATIONAL

    [*] --> setup

    %% Internal transitions
    setup --> plan : setup_done
    plan --> commit_plan : plan_done
    commit_plan --> judge : committed
    judge --> enforce_session : approve
    enforce_session --> validate : enforce_done
    validate --> precommit_check : validate_done
    precommit_check --> done : pass
    precommit_check --> validate : fix_needed
    judge --> plan : revise

    %% External composites
    state TERMINAL

    %% Transitions to other composites
    done --> TERMINAL : completed
    judge --> TERMINAL : reject
    plan --> TERMINAL : timeout(600)
    judge --> TERMINAL : timeout(600)
    enforce_session --> TERMINAL : timeout(900)
