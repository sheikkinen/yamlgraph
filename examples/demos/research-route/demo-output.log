  os_infra_finding: {'persona': 'os-infra-primitivist', 'candidate': 'File-system watch hook (CAP-222 macOS example) triggered by worktree state change, replacing shell-diff polling with OS-native FSEvents or inotify boundary enforcement.', 'solution_class': 'boundary-enforcement', 'verdict': 'pursue', 'precedent': 'CAP-222, CAP-254, does_the_platform_already_do_this', 'is_this_a_graph': 'yes', 'effort_risk': 'medium; FSEvents/inotify integration proven in CAP-222, but cross-platform abstraction and graph-node wrapping add surface.', 'rationale': 'OS already enforces file-change boundaries; leveraging native watch instead of shell-diff closure closes the witnessed 3-hour, 601-line hook cost by delegating to kernel.'}
  data_process_finding: {'persona': 'data-process-planner. I examine whether the input shape, schema, or lifecycle dissolves the problem before guards must catch it.', 'candidate': 'Require solution-class declaration in the FR brief itself, forcing authors to enumerate all candidate classes upfront.', 'solution_class': 'schema-data', 'verdict': 'pursue', 'precedent': 'FR-806-author-sh-brief-preflight.md', 'is_this_a_graph': 'No. This is a schema and checklist change to the FR authoring contract, not a graph-based process.', 'effort_risk': 'Low effort, medium risk. Checklist addition is cheap; risk is adoption friction if authors resist upfront enumeration.', 'rationale': 'The witnessed incidents show authors ship solutions matching their loaded context (shell, hooks) without exploring alternatives. Forcing solution-class enumeration in the brief—before planning—closes input closure and prevents the planner from inheriting blind spots. FR-806 precedent shows this pattern works.'}
  yamlgraph_native_finding: {'persona': 'yamlgraph-native-planner', 'candidate': 'Use research-route graph (FR-890 closed-input alternatives route) to fan-out orthogonal planner personas across solution classes, reducing findings into deterministic alternatives table instead of loading author context.', 'solution_class': 'graph-pipeline', 'verdict': 'pursue', 'precedent': 'FR-890, research-route (examples/demos/research-route/graph.yaml), corpus-census (examples/demos/corpus_census/graph.yaml)', 'is_this_a_graph': 'research-route: load problem brief, collect known graph task shapes, fan out to orthogonal planner personas, reduce findings into deterministic alternatives table.', 'effort_risk': 'low/medium: graph skeleton exists; planner personas need authoring but map-reduce pattern is proven in corpus_census and cap_journey_census.', 'rationale': 'Witnessed incidents show author context bias (shell→shell, hooks→hooks). research-route pattern directly addresses this by fanning out independent personas across solution classes, ensuring OS-permissions and other alternatives surface deterministically without author-loaded context steering the result.'}
  subtractionist_finding: {'persona': 'Subtractionist: I prefer deletion, scope reduction, or explicit non-goals over automation when they fit better.', 'candidate': 'Delete the requirement to auto-propose solution classes from loaded context (shell→shell, hooks→hooks). Instead, enforce a mandatory planning phase that queries all seven solution classes—os-permissions, process-boundary, schema-data, graph-pipeline, subtraction, external-method, boundary-enforcement—before committing to one.', 'solution_class': 'graph-pipeline', 'verdict': 'pursue', 'precedent': 'FR-806-author-sh-brief-preflight.md, CAP-248-research-sole-route-closed-input-alternatives, scripture-key: ask_before_generate', 'is_this_a_graph': 'Yes. The planning phase must enumerate all solution classes as a closed-input graph traversal, not a daemon or open-ended search.', 'effort_risk': 'Medium effort, low risk. Adds one planning graph node; reuses existing capability registry and sole-route pattern from FR-767 and CAP-248.', 'rationale': 'The witnessed incidents (2026-08-25) show that context-loaded solutions blind planners to available alternatives. A mandatory enumeration graph closes the input space and prevents the 601-line hook anti-pattern by forcing consideration of os-permissions and other classes upfront.'}
