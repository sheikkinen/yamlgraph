📋 Part 1: Generate Agent Card from graph metadata
  Command: yamlgraph a2a card examples/demos/hello/
---
{
  "capabilities": {
    "streaming": true
  },
  "defaultInputModes": [
    "text"
  ],
  "defaultOutputModes": [
    "text"
  ],
  "description": "YAMLGraph graphs exposed as A2A agents",
  "name": "YAMLGraph A2A Server",
  "preferredTransport": "JSONRPC",
  "protocolVersion": "0.3.0",
  "skills": [
    {
      "description": "Simple greeting generator demonstrating basic LLM usage",
      "id": "hello-world",
      "name": "hello-world",
      "tags": [
        "yamlgraph"
      ]
    }
  ],
  "url": "http://localhost:8080/",
  "version": "0.4.63"
}

