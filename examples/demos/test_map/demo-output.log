ull_request', 'tests/unit/test_commitlint_workflow.py::TestWorkflowTrigger::test_triggers_on_required_event_types', 'tests/unit/test_commitlint_workflow.py::TestWorkflowTypes::test_workflow_allows_all_expected_types', 'tests/unit/test_commitlint_workflow.py::TestWorkflowTypes::test_revert_type_included', 'tests/unit/test_commitlint_workflow.py::TestTypeParity::test_ci_types_match_local_hook_types', 'tests/unit/test_commitlint_workflow.py::TestTypeParity::test_precommit_includes_revert', 'tests/unit/test_commitlint_workflow.py::TestFeatFREnforcement::test_feat_fr_step_exists', 'tests/unit/test_commitlint_workflow.py::TestFeatFREnforcement::test_feat_fr_step_uses_env_not_inline', 'tests/unit/test_commitlint_workflow.py::TestFeatFREnforcement::test_feat_fr_step_has_conditional', 'tests/unit/test_commitlint_workflow.py::TestFeatFREnforcement::test_feat_fr_step_checks_fr_pattern', 'tests/unit/test_commitlint_workflow.py::TestWorkflowPermissions::test_has_pull_requests_read_permission'], 'text': '# file: tests/unit/test_commitlint_workflow.py (partition 1)\n# imports\nfrom pathlib import Path\nimport pytest\nimport yaml\n\n# --- test tests/unit/test_commitlint_workflow.py::TestCommitlintWorkflowExists::test_workflow_file_exists (line 63)\n# in class TestCommitlintWorkflowExists\n    def test_workflow_file_exists(self) -> None:\n        """commitlint.yml must exist in .github/workflows/."""\n        assert WORKFLOW_PATH.exists(), (\n            f"Missing: {WORKFLOW_PATH.relative_to(REPO_ROOT)}"\n        )\n\n# --- test tests/unit/test_commitlint_workflow.py::TestCommitlintWorkflowExists::test_workflow_is_valid_yaml (line 69)\n# in class TestCommitlintWorkflowExists\n    def test_workflow_is_valid_yaml(self) -> None:\n        """The workflow file must be parseable YAML."""\n        wf = _load_workflow()\n        assert isinstance(wf, dict), "Workflow must be a YAML mapping"\n\n# --- test tests/unit/test_commitlint_workflow.py::TestWorkflowTrigger::test_triggers_on_pull_request (line 79)\n# in class TestWorkflowTrigger\n    def test_triggers_on_pull_request(self) -> None:\n        """Workflow must trigger on pull_request events."""\n        wf = _load_workflow()\n        assert "pull_request" in wf.get("on", wf.get(True, {})), (\n            "Workflow must trigger on pull_request"\n        )\n\n# --- test tests/unit/test_commitlint_workflow.py::TestWorkflowTrigger::test_triggers_on_required_event_types (line 86)\n# in class TestWorkflowTrigger\n    def test_triggers_on_required_event_types(self) -> None:\n        """Workflow must trigger on opened, edited, synchronize, reopened."""\n        wf = _load_workflow()\n        pr_config = wf.get("on", wf.get(True, {})).get("pull_request", {})\n        event_types = set(pr_config.get("types", []))\n        required = {"opened", "edited", "synchronize", "reopened"}\n        assert required <= event_types, (\n            f"Missing PR event types: {required - event_types}"\n        )\n\n# --- test tests/unit/test_commitlint_workflow.py::TestWorkflowTypes::test_workflow_allows_all_expected_types (line 101)\n# in class TestWorkflowTypes\n    def test_workflow_allows_all_expected_types(self) -> None:\n        """The semantic PR action must allow all expected conventional types."""\n        wf = _load_workflow()\n        steps = wf["jobs"]["commitlint"]["steps"]\n        semantic_step = next(\n            s for s in steps if "action-semantic-pull-request" in s.get("uses", "")\n        )\n        types_str = semantic_step["with"]["types"]\n        workflow_types = sorted(\n            t.strip() for t in types_str.strip().split("\\n") if t.strip()\n        )\n        assert workflow_types == EXPECTED_TYPES, (\n            f"Workflow types {workflow_types} != expected {EXPECTED_TYPES}"\n        )\n\n# --- test tests/unit/test_commitlint_workflow.py::TestWorkflowTypes::test_revert_type_included (line 116)\n# in class TestWorkflowTypes\n    def test_revert_type_included(self) -> None:\n        """The \'revert\' type must be in the allowed types list."""\n        wf = _load_workflow()\n        steps = wf["jobs"]["commitlint"]["steps"]\n        semantic_step = next(\n            s for s in steps if "action-semantic-pull-request" in s.get("uses", "")\n        )\n        types_str = semantic_step["with"]["types"]\n        types_list = [t.strip() for t in types_str.strip().split("\\n") if t.strip()]\n        assert "revert" in types_list, "revert must be in allowed types"\n\n# --- test tests/unit/test_commitlint_workflow.py::TestTypeParity::test_ci_types_match_local_hook_types (line 132)\n# in class TestTypeParity\n    def test_ci_types_match_local_hook_types(self) -> None:\n        """Workflow types must match .pre-commit-config.yaml conventional-pre-commit args."""\n        wf = _load_workflow()\n        steps = wf["jobs"]["commitlint"]["steps"]\n        semantic_step = next(\n            s for s in steps if "action-semantic-pull-request" in s.get("uses", "")\n        )\n        types_str = semantic_step["with"]["types"]\n        ci_types = sorted(t.strip() for t in types_str.strip().split("\\n") if t.strip())\n\n        local_types = _get_precommit_conventional_types()\n        assert ci_types == local_types, (\n            f"CI types {ci_types} != local hook types {local_types}"\n        )\n\n# --- test tests/unit/test_commitlint_workflow.py::TestTypeParity::test_precommit_includes_revert (line 147)\n# in class TestTypeParity\n    def test_precommit_includes_revert(self) -> None:\n        """The local conventional-pre-commit hook must include \'revert\' type."""\n        local_types = _get_precommit_conventional_types()\n        assert "revert" in local_types, (\n            "revert must be in conventional-pre-commit args for parity"\n        )\n\n# --- test tests/unit/test_commitlint_workflow.py::TestFeatFREnforcement::test_feat_fr_step_exists (line 159)\n# in class TestFeatFREnforcement\n    def test_feat_fr_step_exists(self) -> None:\n        """A step enforcing FR-XXX on feat PRs must exist."""\n        wf = _load_workflow()\n        steps = wf["jobs"]["commitlint"]["steps"]\n        fr_steps = [s for s in steps if "FR-XXX" in s.get("name", "")]\n        assert len(fr_steps) == 1, "Exactly one FR-XXX enforcement step expected"\n\n# --- test tests/unit/test_commitlint_workflow.py::TestFeatFREnforcement::test_feat_fr_step_uses_env_not_inline (line 166)\n# in class TestFeatFREnforcement\n    def test_feat_fr_step_uses_env_not_inline(self) -> None:\n        """The FR-XXX step must use env block (not inline ${{ }}) for security."""\n        wf = _load_workflow()\n        steps = wf["jobs"]["commitlint"]["steps"]\n        fr_step = next(s for s in steps if "FR-XXX" in s.get("name", ""))\n        run_script = fr_step.get("run", "")\n        assert "$PR_TITLE" in run_script, (\n            "Script must reference $PR_TITLE from env block"\n        )\n        assert "${{" not in run_script, (\n            "Script must NOT use ${{ }} inline interpolation (injection risk)"\n        )\n\n# --- test tests/unit/test_commitlint_workflow.py::TestFeatFREnforcement::test_feat_fr_step_has_conditional (line 179)\n# in class TestFeatFREnforcement\n    def test_feat_fr_step_has_conditional(self) -> None:\n        """The FR-XXX step must only run for feat PRs (if condition)."""\n        wf = _load_workflow()\n        steps = wf["jobs"]["commitlint"]["steps"]\n        fr_step = next(s for s in steps if "FR-XXX" in s.get("name", ""))\n        assert "if" in fr_step, "FR-XXX step must have an \'if\' condition"\n        assert "feat" in fr_step["if"], "if condition must check for \'feat\'"\n\n# --- test tests/unit/test_commitlint_workflow.py::TestFeatFREnforcement::test_feat_fr_step_checks_fr_pattern (line 187)\n# in class TestFeatFREnforcement\n    def test_feat_fr_step_checks_fr_pattern(self) -> None:\n        """The FR-XXX step script must grep for FR-[0-9]+ pattern."""\n        wf = _load_workflow()\n        steps = wf["jobs"]["commitlint"]["step