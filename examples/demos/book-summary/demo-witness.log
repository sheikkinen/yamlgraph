  render_results: [{'_map_index': 0, 'task_id': None, 'tool': 'render_page', 'success': True, 'result': {'page': 1, 'image': 'tmp/pages/p1-1.png'}, 'error': None}, {'_map_index': 1, 'task_id': None, 'tool': 'render_page', 'success': True, 'result': {'page': 2, 'image': 'tmp/pages/p2-2.png'}, 'error': None}, {'_map_index': 2, 'task_id': None, 'tool': 'render_page', 'success': True, 'result': {'page': 3, 'image': 'tmp/pages/p3-3.png'}, 'error': None}]
